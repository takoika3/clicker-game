<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>伝説の茸神</title>

<style>

body{
background:#151515;
color:white;
font-family:sans-serif;
padding:20px;
}

.panel{
border:1px solid #555;
padding:10px;
margin-bottom:10px;
}

button{
padding:5px;
margin:3px;
}

.legend{
color:orange;
}

.mythic{
color:#ff00ff;
}

</style>
</head>
<body>

<h1>🍄伝説の茸神</h1>

<div class="panel">

<h2>プレイヤー</h2>

Lv:
<span id="level">1</span>

<br>

攻撃:
<span id="atk">10</span>

<br>

HP:
<span id="hp">100</span>

<br>

Gold:
<span id="gold">0</span>

<br>

転生:
<span id="rebirth">0</span>

</div>

<div class="panel">

<h2>敵</h2>

ステージ:
<span id="stage">1</span>

<br>

敵HP:
<span id="enemyhp">100</span>

</div>

<div class="panel">

<h2>行動</h2>

<button onclick="gacha()">
ガチャ(100G)
</button>

<button onclick="buySkill('atk')">
攻撃強化
</button>

<button onclick="buySkill('crit')">
クリティカル
</button>

<button onclick="rebirth()">
転生
</button>

</div>

<div class="panel">

<h2>装備</h2>

<div id="equip"></div>

</div>

<div class="panel">

<h2>ログ</h2>

<div id="log"></div>

</div>

<script>

const rarityTable = [

{name:"N",rate:50,multi:1},
{name:"R",rate:25,multi:2},
{name:"SR",rate:12,multi:4},
{name:"SSR",rate:7,multi:8},
{name:"UR",rate:3,multi:15},
{name:"LR",rate:1.5,multi:30},
{name:"MR",rate:1,multi:60},
{name:"神話",rate:0.4,multi:120},
{name:"創世",rate:0.09,multi:300},
{name:"超越",rate:0.01,multi:1000}

];

let game = {

level:1,
atk:10,
hp:100,
gold:0,

stage:1,

enemyHp:100,
enemyMaxHp:100,

skillPoint:0,
crit:0,

rebirth:0,

equips:[]
};

function addLog(text){

const div=document.getElementById("log");

div.innerHTML=
text+"<br>"+div.innerHTML;

}

function update(){

level.innerText=game.level;
atk.innerText=Math.floor(game.atk);
hp.innerText=Math.floor(game.hp);
gold.innerText=Math.floor(game.gold);
stage.innerText=game.stage;
enemyhp.innerText=Math.floor(game.enemyHp);
rebirth.innerText=game.rebirth;

let html="";

game.equips.forEach(e=>{

html+=`
<div>
${e.name}
(+${e.atk})
</div>
`;

});

equip.innerHTML=html;

}

function battle(){

game.enemyHp-=game.atk;

if(Math.random()<game.crit){

game.enemyHp-=game.atk*2;

}

if(game.enemyHp<=0){

const reward=
50+
game.stage*10;

game.gold+=reward;

game.level++;

if(game.level%5===0){

game.skillPoint++;

}

game.stage++;

game.enemyMaxHp*=1.15;

game.enemyHp=game.enemyMaxHp;

addLog("敵撃破 +" + reward + "G");

}

update();

}

setInterval(battle,1000);

function rollRarity(){

let r=Math.random()*100;

let sum=0;

for(let item of rarityTable){

sum+=item.rate;

if(r<=sum){

return item;

}

}

return rarityTable[0];

}

function gacha(){

if(game.gold<100){

addLog("お金不足");

return;

}

game.gold-=100;

const rarity=rollRarity();

const item={

name:
rarity.name+" 武器",

atk:
Math.floor(
10*rarity.multi
)

};

game.atk+=item.atk;

game.equips.push(item);

addLog(
rarity.name+
"獲得!"
);

update();

}

function buySkill(type){

if(game.skillPoint<=0){

addLog("SP不足");

return;

}

game.skillPoint--;

if(type==="atk"){

game.atk*=1.15;

addLog("攻撃強化");

}

if(type==="crit"){

game.crit+=0.02;

addLog("クリ率UP");

}

update();

}

function rebirth(){

if(game.level<100){

addLog("Lv100必要");

return;

}

game.rebirth++;

let bonus=
1+game.rebirth*0.2;

game.level=1;

game.stage=1;

game.gold=0;

game.atk=10*bonus;

game.enemyMaxHp=100;

game.enemyHp=100;

game.skillPoint=0;

addLog(
"転生成功"
);

update();

}

function save(){

localStorage.setItem(
"mushroomSave",
JSON.stringify(game)
);

}

function load(){

const s=
localStorage.getItem(
"mushroomSave"
);

if(s){

game=
JSON.parse(s);

}

}

load();

setInterval(save,5000);

update();

</script>

</body>
</html>
